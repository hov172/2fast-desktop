<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DesktopCanvasBrush" Color="#F5F7FB" />
            <SolidColorBrush x:Key="DesktopSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DesktopBorderBrush" Color="#DEE4ED" />
            <SolidColorBrush x:Key="DesktopMutedBrush" Color="#536174" />
            <SolidColorBrush x:Key="AccountAccentBrush" Color="#007D96" />
            <SolidColorBrush x:Key="AccountToolbarBrush" Color="#E6EFF2" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DesktopCanvasBrush" Color="#000000" />
            <SolidColorBrush x:Key="DesktopSurfaceBrush" Color="#111111" />
            <SolidColorBrush x:Key="DesktopBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="DesktopMutedBrush" Color="#BDBDBD" />
            <SolidColorBrush x:Key="AccountAccentBrush" Color="#00A2BE" />
            <SolidColorBrush x:Key="AccountToolbarBrush" Color="#183440" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DesktopCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DesktopBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DesktopMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccountAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccountToolbarBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="DesktopButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="DesktopPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="DesktopCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DesktopSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="DesktopHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DesktopCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource DesktopMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>

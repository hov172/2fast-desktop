<ContentDialog
    x:Class="Project2FA.Uno.Views.EditAccountContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit account"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryBTNEnable, Mode=OneWay}"
    PrimaryButtonClick="Save_Click"
    DefaultButton="Primary">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
        <StackPanel Spacing="12" MinWidth="320">
            <TextBox Header="Service" Text="{x:Bind ViewModel.Label, Mode=TwoWay}" />
            <TextBox Header="Account" Text="{x:Bind ViewModel.Issuer, Mode=TwoWay}" />
            <AutoSuggestBox Header="Icon name" Text="{x:Bind ViewModel.AccountIconName, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.FontIdentifikationCollection, Mode=OneWay}"
                            DisplayMemberPath="Name" TextMemberPath="Name"
                            TextChanged="IconName_TextChanged" SuggestionChosen="IconName_SuggestionChosen" />
            <TextBlock Text="Choose a suggested icon. Unrecognized or empty names use the account’s initials." TextWrapping="Wrap" Opacity="0.7" />
            <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
            <TextBlock x:Name="EditError" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

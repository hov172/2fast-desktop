<ContentDialog
    x:Class="Project2FA.Uno.Views.ChangeDatafilePasswordContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change data-file password" PrimaryButtonText="Change password" CloseButtonText="Cancel"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryBTNEnable, Mode=OneWay}"
    PrimaryButtonClick="ChangePassword_Click">
    <StackPanel Spacing="12" MinWidth="320">
        <PasswordBox x:Name="CurrentPasswordBox" Header="Current password" Visibility="{x:Bind ViewModel.PasswordIsNotInvalid, Mode=OneWay}" MaxLength="0" Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay}" />
        <PasswordBox x:Name="NewPasswordBox" Header="New password" MaxLength="0" Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay}" />
        <PasswordBox x:Name="RepeatPasswordBox" Header="Repeat new password" MaxLength="0" Password="{x:Bind ViewModel.NewPasswordRepeat, Mode=TwoWay}" />
        <CheckBox Content="Show passwords" Checked="Reveal_Changed" Unchecked="Reveal_Changed" />
        <TextBlock Text="Changing the password upgrades this vault to authenticated encryption. Updated Windows and macOS desktop builds can open it; older releases and mobile clients cannot. A legacy encrypted copy is kept when upgrading. Biometric unlock must be enabled again." TextWrapping="Wrap" />
        <TextBlock x:Name="ChangeError" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>

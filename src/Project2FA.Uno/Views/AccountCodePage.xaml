<Page
    x:Class="Project2FA.Uno.Views.AccountCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project2FA.Uno.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:toolkit="using:Uno.UI.Toolkit"
    xmlns:models="using:Project2FA.Repository.Models"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:unocontrols="using:Project2FA.Controls"
    xmlns:strings="using:Project2FA.Strings"
    xmlns:helpers="using:Project2FA.Helpers"
    xmlns:not_mobile="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_ios="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ios="http://uno.ui/ios"
    x:Name="Page"
    mc:Ignorable="d not_mobile ios not_ios"
    Background="{ThemeResource DesktopCanvasBrush}">

<Page.Resources><ResourceDictionary>
<DataTemplate x:Key="TwoFACodeCustomTemplate" x:DataType="models:TwoFACodeModel">
 <Border Style="{StaticResource DesktopCardStyle}" Padding="20" Margin="0,0,0,12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <PersonPicture Width="44" Height="44" Margin="0,0,14,0" FontSize="22" DisplayName="{x:Bind Model, Converter={StaticResource PersonalPictureInitialsVisibilityConverter}, Mode=OneWay}" Style="{StaticResource DefaultPersonPictureStyle}" Tag="{x:Bind AccountIconName, Mode=OneWay}" />
    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
     <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}" />
     <TextBlock Text="{x:Bind Issuer, Mode=OneWay}" Style="{StaticResource DesktopCaptionStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
    </StackPanel>
   </Grid>
   <Button Grid.Column="1" Tag="{x:Bind}" Click="BTN_SetFavourite_Click" Style="{StaticResource TransparentButtonStyle}" Width="40" Height="40" AutomationProperties.Name="Toggle favorite" ToolTipService.ToolTip="{x:Bind IsFavourite, Converter={StaticResource FavouriteTooltipConverter}, Mode=OneWay}">
    <FontIcon Glyph="{x:Bind IsFavourite, Converter={StaticResource FavouriteToIconConverter}, Mode=OneWay}" FontSize="18" />
   </Button>
   <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Grid>
      <TextBlock Text="{x:Bind TwoFACode, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource SystemAccentColor}" Visibility="{x:Bind HideTOTPCode, Converter={StaticResource VisibleWhenFalseConverter}, Mode=OneWay}" />
      <TextBlock Text="••• •••" FontSize="32" Visibility="{x:Bind HideTOTPCode, Mode=OneWay}" />
     </Grid>
     <Button Tag="{x:Bind}" Click="BTN_ShowCode_Click" Visibility="{x:Bind CodeVisibilityOptionEnabled, Mode=OneWay}" Style="{StaticResource TransparentButtonStyle}" AutomationProperties.Name="Show or hide code" Width="40" Height="40">
      <FontIcon Glyph="{x:Bind HideTOTPCode, Converter={StaticResource ShowCodeToIconConverter}, Mode=OneWay}" FontSize="18" />
     </Button>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <ProgressRing Value="{x:Bind Seconds, Mode=OneWay}" Maximum="{x:Bind Period, Mode=OneWay}" Minimum="0" IsIndeterminate="False" Width="28" Height="28" AutomationProperties.Name="Time remaining" />
     <TextBlock Text="{x:Bind Seconds, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
     <TextBlock Text="s" Style="{StaticResource DesktopCaptionStyle}" />
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="Copy code" Tag="{x:Bind}" Click="BTN_CopyCode_Click" Style="{StaticResource DesktopPrimaryButtonStyle}" />
     <Button Content="Edit" Tag="{x:Bind}" Click="MFI_EditAccount_Click" Style="{StaticResource DesktopButtonStyle}" />
     <Button Content="View QR" Tag="{x:Bind}" Click="MFI_ExportAccount_Click" Style="{StaticResource DesktopButtonStyle}" />
     <Button Content="OCRA challenge" Tag="{x:Bind}" Click="OcraChallenge_Click" Visibility="{x:Bind OcraActionVisibility, Mode=OneWay}" Style="{StaticResource DesktopButtonStyle}" />
     <Button Content="More" Style="{StaticResource DesktopButtonStyle}" AutomationProperties.Name="More account actions">
      <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Delete account…" Tag="{x:Bind}" Click="MFI_DeleteAccount_Click" /></MenuFlyout></Button.Flyout>
     </Button>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</DataTemplate>

<DataTemplate x:Key="TwoFACodeCustomAccentTemplate" x:DataType="models:TwoFACodeModel">
 <Border Style="{StaticResource DesktopCardStyle}" Padding="20" Margin="0,0,0,12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <PersonPicture Background="{ThemeResource SystemAccentColor}" Foreground="White" Width="44" Height="44" Margin="0,0,14,0" FontSize="22" DisplayName="{x:Bind Model, Converter={StaticResource PersonalPictureInitialsVisibilityConverter}, Mode=OneWay}" Style="{StaticResource DefaultPersonPictureStyle}" Tag="{x:Bind AccountIconName, Mode=OneWay}" />
    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
     <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}" />
     <TextBlock Text="{x:Bind Issuer, Mode=OneWay}" Style="{StaticResource DesktopCaptionStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
    </StackPanel>
   </Grid>
   <Button Grid.Column="1" Tag="{x:Bind}" Click="BTN_SetFavourite_Click" Style="{StaticResource TransparentButtonStyle}" Width="40" Height="40" AutomationProperties.Name="Toggle favorite" ToolTipService.ToolTip="{x:Bind IsFavourite, Converter={StaticResource FavouriteTooltipConverter}, Mode=OneWay}">
    <FontIcon Glyph="{x:Bind IsFavourite, Converter={StaticResource FavouriteToIconConverter}, Mode=OneWay}" FontSize="18" />
   </Button>
   <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Grid>
      <TextBlock Text="{x:Bind TwoFACode, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource SystemAccentColor}" Visibility="{x:Bind HideTOTPCode, Converter={StaticResource VisibleWhenFalseConverter}, Mode=OneWay}" />
      <TextBlock Text="••• •••" FontSize="32" Visibility="{x:Bind HideTOTPCode, Mode=OneWay}" />
     </Grid>
     <Button Tag="{x:Bind}" Click="BTN_ShowCode_Click" Visibility="{x:Bind CodeVisibilityOptionEnabled, Mode=OneWay}" Style="{StaticResource TransparentButtonStyle}" AutomationProperties.Name="Show or hide code" Width="40" Height="40">
      <FontIcon Glyph="{x:Bind HideTOTPCode, Converter={StaticResource ShowCodeToIconConverter}, Mode=OneWay}" FontSize="18" />
     </Button>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <ProgressRing Value="{x:Bind Seconds, Mode=OneWay}" Maximum="{x:Bind Period, Mode=OneWay}" Minimum="0" IsIndeterminate="False" Width="28" Height="28" AutomationProperties.Name="Time remaining" />
     <TextBlock Text="{x:Bind Seconds, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
     <TextBlock Text="s" Style="{StaticResource DesktopCaptionStyle}" />
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="Copy code" Tag="{x:Bind}" Click="BTN_CopyCode_Click" Style="{StaticResource DesktopPrimaryButtonStyle}" />
     <Button Content="Edit" Tag="{x:Bind}" Click="MFI_EditAccount_Click" Style="{StaticResource DesktopButtonStyle}" />
     <Button Content="View QR" Tag="{x:Bind}" Click="MFI_ExportAccount_Click" Style="{StaticResource DesktopButtonStyle}" />
     <Button Content="OCRA challenge" Tag="{x:Bind}" Click="OcraChallenge_Click" Visibility="{x:Bind OcraActionVisibility, Mode=OneWay}" Style="{StaticResource DesktopButtonStyle}" />
     <Button Content="More" Style="{StaticResource DesktopButtonStyle}" AutomationProperties.Name="More account actions">
      <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Delete account…" Tag="{x:Bind}" Click="MFI_DeleteAccount_Click" /></MenuFlyout></Button.Flyout>
     </Button>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</DataTemplate>

<helpers:AccountAvatarTemplateSelector x:Key="AccountAvatarTemplateSelector" Normal="{StaticResource TwoFACodeCustomTemplate}" Accent="{StaticResource TwoFACodeCustomAccentTemplate}" />
</ResourceDictionary></Page.Resources>

<Grid MaxWidth="1080" HorizontalAlignment="Stretch" Margin="24,24,24,0">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,22">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Spacing="4"><TextBlock Text="{x:Bind strings:Resources.AccountCodePageTitle}" Style="{StaticResource DesktopHeadingStyle}"/><TextBlock Text="Your verification codes, in one place." Style="{StaticResource DesktopCaptionStyle}"/></StackPanel>
  <Button x:Name="ABB_Logout" Grid.Column="1" Content="Lock vault" VerticalAlignment="Top"  Style="{StaticResource DesktopButtonStyle}" />
 </Grid>
 <StackPanel Grid.Row="1" Spacing="14" Margin="0,0,0,16">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="ScreenScanMenuItem" Content="Scan screen" Click="ScreenScanMenuItem_Click" Style="{StaticResource DesktopPrimaryButtonStyle}" ToolTipService.ToolTip="Scan a QR from a browser window or display" />
    <Button x:Name="CameraAction" Content="Scan camera" Style="{StaticResource DesktopButtonStyle}" />
    <Button x:Name="ManualAction" Content="Add manually" Style="{StaticResource DesktopButtonStyle}" />
    <Button x:Name="OcraMenuItem" Content="Add OCRA" Click="OcraMenuItem_Click" Style="{StaticResource DesktopButtonStyle}" />
    <Button x:Name="ABB_Refresh" Content="Sync"  Style="{StaticResource DesktopButtonStyle}" />
   </StackPanel>
  </ScrollViewer>
  <AutoSuggestBox x:Name="MobileAutoSuggestBox" PlaceholderText="Search accounts or services" AutomationProperties.Name="Search accounts" Text="{Binding SearchedAccountLabel, Mode=TwoWay}"  TextChanged="AutoSuggestBox_TextChanged" SuggestionChosen="AutoSuggestBox_SuggestionChosen" GotFocus="AutoSuggestBox_GotFocus" UpdateTextOnSelect="False" TextMemberPath="Label" MinHeight="40">
   <AutoSuggestBox.QueryIcon><FontIcon Glyph="&#xE721;"/></AutoSuggestBox.QueryIcon>
  </AutoSuggestBox>
  <TextBlock x:Name="CollectionSummary" Style="{StaticResource DesktopCaptionStyle}" AutomationProperties.LiveSetting="Polite" />
 </StackPanel>
 <Grid x:Name="MainGrid" Grid.Row="2">
  <ProgressRing IsActive="{Binding TwoFADataService.IsLoading, Mode=OneWay}" Visibility="{Binding TwoFADataService.IsLoading, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" />
  <ListView x:Name="LV_AccountCollection"  ItemTemplateSelector="{StaticResource AccountAvatarTemplateSelector}" SelectionMode="None" IsSynchronizedWithCurrentItem="False" HorizontalContentAlignment="Stretch" Padding="0,0,0,24">
   <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource TwoFASelectionListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></ListView.ItemContainerStyle>
  </ListView>
  <Border x:Name="EmptyState" Style="{StaticResource DesktopCardStyle}" VerticalAlignment="Top" Visibility="Collapsed">
   <StackPanel Spacing="12" Margin="16,20" HorizontalAlignment="Center" MaxWidth="380">
    <FontIcon Glyph="&#xE72E;" FontSize="36" Foreground="{ThemeResource SystemAccentColor}" />
    <TextBlock x:Name="EmptyTitle" Text="Add your first account" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
    <TextBlock x:Name="EmptyDescription" Text="Scan a setup QR from your screen or camera, or enter a setup key manually." Style="{StaticResource DesktopCaptionStyle}" TextAlignment="Center" />
   </StackPanel>
  </Border>
 </Grid>
</Grid>
</Page>

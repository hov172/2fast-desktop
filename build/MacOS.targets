<Project>
  <!-- Keep each project's normal customizations, then restrict this build to macOS. -->
  <PropertyGroup>
    <MacOSOriginalBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildProjectDirectory)'))</MacOSOriginalBuildTargets>
  </PropertyGroup>
  <Import Project="$(MacOSOriginalBuildTargets)" Condition="'$(MacOSOriginalBuildTargets)' != ''" />
  <PropertyGroup>
    <TargetFrameworks Condition="'$(TargetFrameworks)' != ''">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(MSBuildProjectName)' == 'Project2FA.Uno' or '$(MSBuildProjectName)' == 'UnoLibrary.Controls' or '$(MSBuildProjectName)' == 'CommunityToolkit.Uno.Camera' or '$(MSBuildProjectName)' == 'ZXing.Net.Uno' or '$(MSBuildProjectName)' == 'BiometryService'">net10.0-desktop</TargetFrameworks>
  </PropertyGroup>
</Project>

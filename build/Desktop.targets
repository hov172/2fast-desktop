<Project>
  <!-- Keep each project's normal customizations, then restrict this build to the desktop target. -->
  <PropertyGroup>
    <DesktopOriginalBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildProjectDirectory)'))</DesktopOriginalBuildTargets>
  </PropertyGroup>
  <Import Project="$(DesktopOriginalBuildTargets)" Condition="'$(DesktopOriginalBuildTargets)' != ''" />
  <PropertyGroup>
    <TargetFrameworks Condition="'$(TargetFrameworks)' != ''">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(MSBuildProjectName)' == 'Project2FA.Uno' or '$(MSBuildProjectName)' == 'UnoLibrary.Controls' or '$(MSBuildProjectName)' == 'CommunityToolkit.Uno.Camera' or '$(MSBuildProjectName)' == 'ZXing.Net.Uno' or '$(MSBuildProjectName)' == 'BiometryService'">net10.0-desktop</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EmbedAllSources>false</EmbedAllSources>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=/_/src</PathMap>
    <Deterministic>true</Deterministic>
    <UnoGenerateHotReloadInfo>false</UnoGenerateHotReloadInfo>
  </PropertyGroup>
  <Target Name="RemoveReleaseSymbolsFromPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveReleaseEmbeddedSources" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
    <!-- Uno's resource injector probes adjacent PDBs even when symbols are disabled. -->
    <Delete Files="$(IntermediateOutputPath)$(TargetName).pdb;$(TargetDir)$(TargetName).pdb" />
    <ItemGroup><EmbeddedFiles Remove="@(EmbeddedFiles)" /></ItemGroup>
  </Target>
</Project>
